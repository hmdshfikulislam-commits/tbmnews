rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /news/{documentId} {
      // The public homepage reads legacy news directly from Firestore.
      allow get, list: if true;

      // Admin publishing goes through the authenticated Neon API, not Firestore.
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
